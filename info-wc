#!/usr/bin/env bash
set -euo pipefail

VERSION=3.0
CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/info-wc
CACHE_FILE=$CACHE_DIR/public-ip
TTL=900
BAR_W=10

refresh=0
net=1
anim=1
anim_time=0.3

detect_lang() {
  local l=${LC_ALL:-${LC_MESSAGES:-${LANGUAGE:-${LANG:-}}}}
  l=${l%%:*}
  l=${l%%.*}
  case $l in
    es*) printf 'es' ;;
    en*) printf 'en' ;;
    *) printf 'en' ;;
  esac
}

lang=${INFO_WC_LANG:-$(detect_lang)}
case $lang in
  es|en) ;;
  *) lang=en ;;
esac

t() {
  case "$lang:$1" in
    es:system) printf 'SISTEMA' ;;
    en:system) printf 'SYSTEM' ;;
    es:hardware) printf 'HARDWARE' ;;
    en:hardware) printf 'HARDWARE' ;;
    es:performance) printf 'RENDIMIENTO' ;;
    en:performance) printf 'PERFORMANCE' ;;
    es:memory) printf 'MEMORIA' ;;
    en:memory) printf 'MEMORY' ;;
    es:uptime) printf 'Activo' ;;
    en:uptime) printf 'Uptime' ;;
    es:cores) printf 'Núcleos' ;;
    en:cores) printf 'Cores' ;;
    es:public) printf 'Pública' ;;
    en:public) printf 'Public' ;;
    es:load) printf 'Carga' ;;
    en:load) printf 'Load' ;;
    es:disk) printf 'Disco' ;;
    en:disk) printf 'Disk' ;;
    es:offline) printf 'sin conexión' ;;
    en:offline) printf 'offline' ;;
    es:disabled_net) printf 'desactivada (-n)' ;;
    en:disabled_net) printf 'disabled (-n)' ;;
    es:na) printf 'n/d' ;;
    en:na) printf 'n/a' ;;
    es:full) printf 'llena' ;;
    en:full) printf 'full' ;;
    es:charging) printf 'cargando' ;;
    en:charging) printf 'charging' ;;
    es:discharging) printf 'descarga' ;;
    en:discharging) printf 'discharging' ;;
    es:missing_value) printf 'falta el valor de' ;;
    en:missing_value) printf 'missing value for' ;;
    es:invalid_time) printf 'tiempo inválido' ;;
    en:invalid_time) printf 'invalid time' ;;
    es:unsupported_lang) printf 'idioma no soportado (usa es o en)' ;;
    en:unsupported_lang) printf 'unsupported language (use es or en)' ;;
    es:unknown_option) printf 'opción desconocida' ;;
    en:unknown_option) printf 'unknown option' ;;
  esac
}

usage() {
  if [[ $lang == es ]]; then
    cat <<'EOF'
info-wc - resumen del sistema estilo neofetch, en rojo neón

uso: info-wc [opciones]

  -r, --refresh   ignora la caché y vuelve a consultar la IP pública
  -n, --no-net    no consulta la IP pública
  -q, --no-anim   sin animación (salida estática)
  -t, --time S    duración de la animación en segundos (0 la desactiva)
  -l, --lang L    idioma: es o en (por defecto, según LANG)
  -V, --version   muestra la versión
  -h, --help      muestra esta ayuda
EOF
  else
    cat <<'EOF'
info-wc - neofetch-style system summary in neon red

usage: info-wc [options]

  -r, --refresh   ignore the cache and refresh the public IP
  -n, --no-net    do not query the public IP
  -q, --no-anim   disable the animation (static output)
  -t, --time S    animation duration in seconds (0 disables it)
  -l, --lang L    language: es or en (default: from LANG)
  -V, --version   show version
  -h, --help      show this help
EOF
  fi
}

while (( $# )); do
  case $1 in
    -r|--refresh) refresh=1; shift ;;
    -n|--no-net)  net=0; shift ;;
    -q|--no-anim) anim=0; shift ;;
    -l|--lang)
      [[ $# -ge 2 ]] || { printf 'info-wc: %s %s\n' "$(t missing_value)" "$1" >&2; exit 2; }
      case $2 in
        es|en) lang=$2 ;;
        *) printf 'info-wc: %s: %s\n' "$(t unsupported_lang)" "$2" >&2; exit 2 ;;
      esac
      shift 2 ;;
    -t|--time)
      [[ $# -ge 2 ]] || { printf 'info-wc: %s %s\n' "$(t missing_value)" "$1" >&2; exit 2; }
      anim_time=$2
      [[ $anim_time =~ ^[0-9]+([.][0-9]+)?$ ]] || { printf 'info-wc: %s: %s\n' "$(t invalid_time)" "$anim_time" >&2; exit 2; }
      if [[ $anim_time =~ ^0+([.]0+)?$ ]]; then anim=0; else anim=1; fi
      shift 2 ;;
    -V|--version) printf 'info-wc %s\n' "$VERSION"; exit 0 ;;
    -h|--help)    usage; exit 0 ;;
    *) printf 'info-wc: %s: %s\n' "$(t unknown_option)" "$1" >&2; exit 2 ;;
  esac
done

is_tty=0
if [[ -t 1 ]]; then is_tty=1; fi

color_mode=0
if (( is_tty )) && [[ -z ${NO_COLOR:-} && ${TERM:-} != dumb ]]; then
  if [[ ${COLORTERM:-} == *truecolor* || ${COLORTERM:-} == *24bit* ]]; then
    color_mode=3
  elif [[ ${TERM:-} == *256color* ]]; then
    color_mode=2
  else
    color_mode=1
  fi
fi

if (( ! is_tty || ! color_mode )); then anim=0; fi

anim_rule_delay=0
anim_bar_delay=0
if (( anim )); then
  anim_rule_delay=$(awk -v t="$anim_time" 'BEGIN{printf "%.6f", t * 0.25 / 11}')
  anim_bar_delay=$(awk -v t="$anim_time" 'BEGIN{printf "%.6f", t * 0.75 / 6}')
fi

fg() {
  local r=$1 g=$2 b=$3
  case $color_mode in
    3) printf '\033[38;2;%d;%d;%dm' "$r" "$g" "$b" ;;
    2)
      local rr=$(( (r * 5 + 127) / 255 ))
      local gg=$(( (g * 5 + 127) / 255 ))
      local bb=$(( (b * 5 + 127) / 255 ))
      printf '\033[38;5;%dm' $(( 16 + 36 * rr + 6 * gg + bb ))
      ;;
    1)
      if (( r >= 200 )); then printf '\033[91m'
      elif (( r + g + b > 120 )); then printf '\033[31m'
      else printf '\033[2;31m'; fi
      ;;
    *) printf '' ;;
  esac
}

if (( color_mode )); then
  RST=$'\033[0m'
  BLD=$'\033[1m'
else
  RST=''
  BLD=''
fi

C_RED=$(fg 255 0 0)

tmp_cache=''
cleanup() {
  [[ -n $tmp_cache ]] && rm -f -- "$tmp_cache"
  return 0
}
trap cleanup EXIT

cols=${COLUMNS:-}
if [[ ! $cols =~ ^[0-9]+$ ]]; then
  cols=$(tput cols 2>/dev/null || echo 80)
fi
if [[ ! $cols =~ ^[0-9]+$ ]]; then cols=80; fi
if (( cols > 84 )); then cols=84; fi
if (( cols < 40 )); then cols=40; fi

wide=0
if (( cols >= 78 )); then wide=1; fi
LEFT_W=34
GAP=3
RIGHT_W=$(( cols - LEFT_W - GAP - 2 ))
if (( RIGHT_W < 20 )); then wide=0; fi

human() {
  local b=${1:-0} i=0 div=1 whole frac
  local units=(B K M G T)
  while (( b / div >= 1024 && i < 4 )); do
    div=$(( div * 1024 ))
    i=$(( i + 1 ))
  done
  whole=$(( b / div ))
  frac=$(( (b % div) * 10 / div ))
  printf '%d.%d%s' "$whole" "$frac" "${units[i]}"
}

shorten() {
  local s=${1:-} max=${2:-48}
  if (( max < 1 )); then printf ''; return 0; fi
  if (( ${#s} > max )); then
    s=${s:0:max-1}…
  fi
  printf '%s' "$s"
}

fit_detail() {
  local s=${1:-} max=${2:-48} base
  if (( max < 1 )); then printf ''; return 0; fi
  if (( ${#s} <= max )); then printf '%s' "$s"; return 0; fi
  if [[ $s == *' · '* ]]; then
    base=${s%% · *}
    if (( ${#base} <= max )); then printf '%s' "$base"; return 0; fi
  fi
  if [[ $s == */* ]]; then
    base=${s%%/*}
    if (( ${#base} <= max )); then printf '%s' "$base"; return 0; fi
  fi
  shorten "$s" "$max"
}

meminfo() {
  awk -v k="$1" '$1 == k":" { print $2; exit }' /proc/meminfo 2>/dev/null || true
}

cpu_short() {
  local s=$1
  s=${s//(R)/}
  s=${s//(TM)/}
  s=${s//(r)/}
  s=${s//(tm)/}
  s=$(printf '%s' "$s" | sed -E \
    -e 's/[[:space:]]+@[[:space:]]*[0-9.]+[[:space:]]*GHz//Ig' \
    -e 's/[[:space:]]+(with|w\/)[[:space:]]+Radeon.*$//Ig' \
    -e 's/[[:space:]]+Radeon.*$//Ig' \
    -e 's/[[:space:]]+[A-Za-z0-9]+-Core.*$//Ig' \
    -e 's/[[:space:]]+[0-9]+[[:space:]]+Compute Cores.*$//Ig' \
    -e 's/[[:space:]]+[0-9]+C\+[0-9]+G.*$//Ig' \
    -e 's/[[:space:]]+(CPU|Processor)[[:space:]]*$//Ig' \
    -e 's/^[0-9]+(st|nd|rd|th)[[:space:]]+Gen[[:space:]]+//Ig' \
    -e 's/[[:space:]]+/ /g' \
    -e 's/^[[:space:]]+//' \
    -e 's/[[:space:]]+$//')
  shorten "$s" 44
}

gpu_short() {
  local s=$1 vendor=''
  case $s in
    *NVIDIA*) vendor=NVIDIA ;;
    *AMD*|*ATI*|*Advanced\ Micro\ Devices*|*Radeon*) vendor=AMD ;;
    *Intel*) vendor=Intel ;;
  esac
  s=$(printf '%s' "$s" | sed -E \
    -e 's/Advanced Micro Devices, Inc\. \[AMD\/ATI\]/AMD/g' \
    -e 's/\[AMD\/ATI\]//g' \
    -e 's/NVIDIA Corporation/NVIDIA/g' \
    -e 's/Intel Corporation/Intel/g' \
    -e 's/\(rev [0-9a-fA-F]+\)//g' \
    -e 's/[[:space:]]+/ /g' \
    -e 's/^[[:space:]]+//' \
    -e 's/[[:space:]]+$//')
  if [[ $s == *'['*']'* ]]; then
    s=$(printf '%s' "$s" | sed -E 's/.*\[([^]]*)\].*/\1/')
  fi
  s=$(printf '%s' "$s" | sed -E \
    -e 's/[[:space:]]+Graphics[[:space:]]*$//Ig' \
    -e 's/[[:space:]]+/ /g' \
    -e 's/^[[:space:]]+//' \
    -e 's/[[:space:]]+$//')
  if [[ -n $vendor && $s != "$vendor"* ]]; then
    s="$vendor $s"
  fi
  shorten "$s" 52
}

kernel=$(uname -r 2>/dev/null || echo desconocido)
shell_v="bash ${BASH_VERSION%%(*}"

read -r up _ < /proc/uptime || up=0
up=${up%.*}
d=$(( up / 86400 ))
h=$(( up % 86400 / 3600 ))
m=$(( up % 3600 / 60 ))
uptime_str=''
if (( d > 0 )); then uptime_str+="${d}d "; fi
if (( d > 0 || h > 0 )); then uptime_str+="${h}h "; fi
uptime_str+="${m}m"

cpu_model=$(awk -F': ' '/model name/{print $2; exit}' /proc/cpuinfo 2>/dev/null || true)
if [[ -z $cpu_model ]]; then cpu_model=$(uname -m 2>/dev/null || echo desconocido); fi
cpu_model=$(cpu_short "$cpu_model")
cores=$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo '?')
cpu_mhz=''
if [[ -r /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq ]]; then
  cpu_mhz=$(awk '{printf "%.1f", $1 / 1000000}' /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq 2>/dev/null || true)
fi
if [[ -z $cpu_mhz ]]; then
  cpu_mhz=$(awk -F': ' '/cpu MHz/{v=$2+0; if(v>m)m=v} END{if(m)printf "%.1f", m/1000}' /proc/cpuinfo 2>/dev/null || true)
fi

read -r l1 l2 l3 _ < /proc/loadavg || { l1=0; l2=0; l3=0; }

mem_total_kb=$(meminfo MemTotal)
mem_avail_kb=$(meminfo MemAvailable)
if [[ -z $mem_avail_kb ]]; then mem_avail_kb=$(meminfo MemFree); fi
mem_total_b=$(( ${mem_total_kb:-0} * 1024 ))
mem_avail_b=$(( ${mem_avail_kb:-0} * 1024 ))
mem_used_b=$(( mem_total_b - mem_avail_b ))
mem_pct=0
if (( mem_total_b > 0 )); then mem_pct=$(( mem_used_b * 100 / mem_total_b )); fi

swap_total_kb=$(meminfo SwapTotal)
swap_free_kb=$(meminfo SwapFree)
swap_total_b=$(( ${swap_total_kb:-0} * 1024 ))
swap_free_b=$(( ${swap_free_kb:-0} * 1024 ))
swap_used_b=$(( swap_total_b - swap_free_b ))
swap_pct=0
if (( swap_total_b > 0 )); then swap_pct=$(( swap_used_b * 100 / swap_total_b )); fi

disk_used=0
disk_size=0
disk_pct=0
disk_mp=/
read -r disk_used disk_size disk_pct disk_mp < <(df -P -B1 / 2>/dev/null | awk 'NR==2{print $3, $2, $5, $6}') || true
disk_used=${disk_used:-0}
disk_size=${disk_size:-0}
disk_pct=${disk_pct:-0}
disk_mp=${disk_mp:-/}
disk_pct=${disk_pct%\%}
disk_ok=0
if [[ $disk_size =~ ^[0-9]+$ ]] && (( disk_size > 0 )); then
  disk_ok=1
fi

home_mp=$(df -P -B1 "$HOME" 2>/dev/null | awk 'NR==2{print $6}' || true)
home_sep=0
home_used=0
home_size=0
home_pct=0
if [[ -n $home_mp && $home_mp != "$disk_mp" ]]; then
  read -r home_used home_size home_pct < <(df -P -B1 "$HOME" 2>/dev/null | awk 'NR==2{print $3, $2, $5}') || true
  home_pct=${home_pct%\%}
  home_used=${home_used:-0}
  home_size=${home_size:-0}
  home_pct=${home_pct:-0}
  home_sep=1
fi

lan_info() {
  local out=''
  if command -v ip >/dev/null 2>&1; then
    out=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++){if($i=="src")s=$(i+1); if($i=="dev")d=$(i+1)}} END{if(s)print d, s}' || true)
    if [[ -z $out ]]; then
      out=$(ip -4 -o addr show scope global 2>/dev/null | awk 'NR==1{print $2, $4}' || true)
      out=${out%%/*}
    fi
  fi
  if [[ -z $out ]]; then
    out=$(hostname -I 2>/dev/null | awk '{print $1}' || true)
  fi
  printf '%s' "${out:-$(t offline)}"
}

valid_ip() {
  local ip=$1 n
  local -a o
  if [[ $ip =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
    local IFS=.
    read -r -a o <<< "$ip"
    for n in "${o[@]}"; do
      (( n <= 255 )) || return 1
    done
    return 0
  fi
  if [[ $ip == *:* && $ip =~ ^[0-9a-fA-F:]+$ && $ip != *:::* ]]; then
    return 0
  fi
  return 1
}

public_ip() {
  local ip='' ts='' cached='' now
  if (( refresh == 0 )) && [[ -s $CACHE_FILE ]]; then
    read -r ts cached < "$CACHE_FILE" || true
    if [[ $ts =~ ^[0-9]+$ ]] && valid_ip "$cached"; then
      now=$(date +%s)
      if (( now - ts < TTL )); then
        printf '%s' "$cached"
        return 0
      fi
    fi
  fi
  ip=$(curl -fsS --max-time 2 https://api.ipify.org 2>/dev/null || true)
  if [[ -z $ip ]]; then
    ip=$(curl -fsS --max-time 2 https://ifconfig.me/ip 2>/dev/null || true)
  fi
  ip=${ip//[$'\r\n ']/}
  if valid_ip "$ip"; then
    if mkdir -p "$CACHE_DIR" 2>/dev/null; then
      tmp_cache=$CACHE_FILE.tmp.$$
      if printf '%s %s\n' "$(date +%s)" "$ip" > "$tmp_cache" 2>/dev/null; then
        mv -f -- "$tmp_cache" "$CACHE_FILE" 2>/dev/null || rm -f -- "$tmp_cache"
        tmp_cache=''
      fi
    fi
    printf '%s' "$ip"
  fi
}

cpu_times() {
  local cpu u n s i w irq sirq st rest
  read -r cpu u n s i w irq sirq st rest < /proc/stat || return 1
  printf '%s %s\n' $(( u + n + s + i + w + irq + sirq + st )) $(( i + w ))
}

collect_cpu() {
  local pt=0 pi=0 ct=0 ci=0 dt di i
  read -r pt pi < <(cpu_times) || { pt=0; pi=0; }
  for (( i=0; i<8; i++ )); do
    sleep 0.025
    read -r ct ci < <(cpu_times) || { ct=$pt; ci=$pi; }
    dt=$(( ct - pt ))
    di=$(( ci - pi ))
    if (( dt > 0 )); then
      hist[i]=$(( (dt - di) * 100 / dt ))
    else
      hist[i]=0
    fi
    pt=$ct
    pi=$ci
  done
  cpu_pct=${hist[7]}
}

gpu_usage() {
  local p='' f
  if command -v nvidia-smi >/dev/null 2>&1; then
    p=$(nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null | head -n1 | tr -d ' ' || true)
  fi
  if [[ ! $p =~ ^[0-9]+$ ]]; then
    for f in /sys/class/drm/card*/device/gpu_busy_percent; do
      [[ -r $f ]] || continue
      p=$(cat "$f" 2>/dev/null || true)
      [[ $p =~ ^[0-9]+$ ]] && break
    done
  fi
  if [[ $p =~ ^[0-9]+$ ]]; then
    printf '%s' "$p"
    return 0
  fi
  return 1
}

cpu_temp() {
  local h name f t z
  for h in /sys/class/hwmon/hwmon*; do
    [[ -r $h/name ]] || continue
    name=$(cat "$h/name" 2>/dev/null || true)
    case $name in
      k10temp|coretemp|zenpower|cpu_thermal|soc_thermal|acpitz) ;;
      *) continue ;;
    esac
    for f in "$h"/temp*_input; do
      [[ -r $f ]] || continue
      t=$(cat "$f" 2>/dev/null || true)
      [[ $t =~ ^[0-9]+$ ]] || continue
      if (( t > 1000 )); then t=$(( t / 1000 )); fi
      printf '%s' "$t"
      return 0
    done
  done
  for z in /sys/class/thermal/thermal_zone*; do
    [[ -r $z/temp && -r $z/type ]] || continue
    case $(cat "$z/type" 2>/dev/null || true) in
      *cpu*|*pkg*|*soc*|acpitz*|x86*) ;;
      *) continue ;;
    esac
    t=$(cat "$z/temp" 2>/dev/null || true)
    [[ $t =~ ^[0-9]+$ ]] || continue
    if (( t > 1000 )); then t=$(( t / 1000 )); fi
    printf '%s' "$t"
    return 0
  done
  for z in /sys/class/thermal/thermal_zone*; do
    [[ -r $z/temp ]] || continue
    t=$(cat "$z/temp" 2>/dev/null || true)
    [[ $t =~ ^[0-9]+$ ]] || continue
    if (( t > 1000 )); then t=$(( t / 1000 )); fi
    printf '%s' "$t"
    return 0
  done
  return 1
}

temp_limit() {
  local f t best=0
  for f in /sys/class/thermal/thermal_zone*/trip_point_*_temp; do
    [[ -r $f ]] || continue
    t=$(cat "$f" 2>/dev/null || true)
    [[ $t =~ ^[0-9]+$ ]] || continue
    if (( t > 1000 )); then t=$(( t / 1000 )); fi
    if (( t > best && t <= 130 )); then
      best=$t
    fi
  done
  if (( best > 0 )); then
    printf '%s' "$best"
  else
    printf '100'
  fi
}

bat_state() {
  case $1 in
    Full|'Not charging') t full ;;
    Charging) t charging ;;
    Discharging) t discharging ;;
    *) printf '%s' "$1" ;;
  esac
}

gpu=$(lspci 2>/dev/null | awk -F': ' '/VGA|3D controller|Display/{print $2; exit}' || true)
gpu=$(gpu_short "$gpu")
gpu_pct=$(gpu_usage || true)
cpu_t=$(cpu_temp || true)
t_limit=$(temp_limit)
t_pct=0
if [[ $cpu_t =~ ^[0-9]+$ ]] && (( t_limit > 0 )); then
  t_pct=$(( cpu_t * 100 / t_limit ))
fi

bat_cap=''
bat_status=''
bat_limit=''
for b in /sys/class/power_supply/BAT*; do
  [[ -e $b ]] || continue
  bat_cap=$(cat "$b/capacity" 2>/dev/null || true)
  bat_status=$(cat "$b/status" 2>/dev/null || true)
  if [[ -r $b/charge_control_end_threshold ]]; then
    bat_limit=$(cat "$b/charge_control_end_threshold" 2>/dev/null || true)
  fi
  break
done

hist=()
collect_cpu

load_pct=0
if [[ $cores =~ ^[0-9]+$ ]] && (( cores > 0 )); then
  load_pct=$(awk -v l="$l1" -v c="$cores" 'BEGIN{printf "%d", l * 100 / c}')
fi

GLYPH=(▁ ▂ ▃ ▄ ▅ ▆ ▇ █)

draw_bar() {
  local pct=$1 w=${2:-$BAR_W} i filled
  if (( pct < 0 )); then pct=0; fi
  if (( pct > 100 )); then pct=100; fi
  filled=$(( pct * w / 100 ))
  printf '%s' "$C_RED"
  for (( i=0; i<w; i++ )); do
    if (( i < filled )); then
      printf '▰'
    else
      printf '▱'
    fi
  done
  printf '%s' "$RST"
}

trow() {
  local label=$1 pct=$2 detail=${3:-} max=$(( cols - 29 )) margin=${4:-1}
  if (( max < 1 )); then max=1; fi
  detail=$(fit_detail "$detail" "$max")
  if (( margin )); then printf '  '; fi
  printf '%s%-5s%s ' "$C_RED" "$label" "$RST"
  draw_bar "$pct" "$BAR_W"
  printf ' %s%3d%%%s' "$BLD$C_RED" "$pct" "$RST"
  if [[ -n $detail ]]; then
    printf '  %s%s%s' "$BLD$C_RED" "$detail" "$RST"
  fi
  printf '\n'
}

trow2() {
  local l1=$1 p1=$2 d1=${3:-} l2=$4 p2=$5 d2=${6:-} L R ll pad lmax rmax
  lmax=$(( LEFT_W - 25 ))
  rmax=$(( RIGHT_W - 25 ))
  if (( lmax < 1 )); then lmax=1; fi
  if (( rmax < 1 )); then rmax=1; fi
  d1=$(fit_detail "$d1" "$lmax")
  d2=$(fit_detail "$d2" "$rmax")
  L=$(trow "$l1" "$p1" "$d1")
  ll=$(( 13 + BAR_W ))
  if [[ -n $d1 ]]; then ll=$(( ll + 2 + ${#d1} )); fi
  pad=$(( LEFT_W + GAP - ll ))
  if (( pad < 2 )); then pad=2; fi
  if [[ -z $l2 ]]; then
    printf '%s\n' "$L"
    return 0
  fi
  R=$(trow "$l2" "$p2" "$d2" 0)
  printf '%s%*s%s\n' "$L" "$pad" '' "$R"
}

hist_str() {
  local i idx
  printf '  %s%-5s%s %s' "$C_RED" 'Hist' "$RST" "$C_RED"
  for (( i=0; i<8; i++ )); do
    idx=$(( hist[i] * 7 / 100 ))
    if (( idx < 0 )); then idx=0; fi
    if (( idx > 7 )); then idx=7; fi
    printf '%s' "${GLYPH[idx]}"
  done
  printf '%s\n' "$RST"
}

draw_rule() {
  local w=$1 i n seg
  if (( anim )); then
    for (( i=0; i<=10; i++ )); do
      n=$(( w * i / 10 ))
      printf '\r  %s' "$C_RED"
      printf -v seg '%*s' "$n" ''
      seg=${seg// /─}
      printf '%s%s\033[K' "$seg" "$RST"
      sleep "$anim_rule_delay"
    done
    printf '\n'
  else
    printf '  %s' "$C_RED"
    printf -v seg '%*s' "$w" ''
    seg=${seg// /─}
    printf '%s%s\n' "$seg" "$RST"
  fi
}

header_seg() {
  local label=$1 width=$2 text left right fl fr
  text=" ${label} "
  left=$(( (width - ${#text}) / 2 ))
  if (( left < 0 )); then left=0; fi
  right=$(( width - ${#text} - left ))
  if (( right < 0 )); then right=0; fi
  printf '%s' "$C_RED"
  printf -v fl '%*s' "$left" ''
  fl=${fl// /─}
  printf '%s' "$fl"
  printf '%s%s%s%s' "$RST" "$BLD$C_RED" "$text" "$RST"
  printf '%s' "$C_RED"
  printf -v fr '%*s' "$right" ''
  fr=${fr// /─}
  printf '%s%s' "$fr" "$RST"
}
hdr2() {
  printf '  '
  header_seg "$1" $(( LEFT_W - 2 ))
  printf '%*s' "$GAP" ''
  header_seg "$2" "$RIGHT_W"
  printf '\n'
}

hdr1() {
  printf '  '
  header_seg "$1" $(( cols - 4 ))
  printf '\n'
}

sline2() {
  local l1=$1 v1=$2 l2=$3 v2=$4 lw rw
  lw=$(( LEFT_W - 10 ))
  rw=$(( RIGHT_W - 8 ))
  if (( lw < 1 )); then lw=1; fi
  if (( rw < 1 )); then rw=1; fi
  v1=$(shorten "$v1" "$lw")
  if [[ -z $l2 ]]; then
    printf '  %s%-7s%s %s%s%s\n' "$C_RED" "$l1" "$RST" "$BLD$C_RED" "$v1" "$RST"
    return 0
  fi
  v2=$(shorten "$v2" "$rw")
  printf '  %s%-7s%s %s%-*s%s   %s%-7s%s %s%-*s%s\n' \
    "$C_RED" "$l1" "$RST" "$BLD$C_RED" "$lw" "$v1" "$RST" \
    "$C_RED" "$l2" "$RST" "$BLD$C_RED" "$rw" "$v2" "$RST"
}

sline1() {
  local l=$1 v=$2 vw
  vw=$(( cols - 12 ))
  if (( vw < 1 )); then vw=1; fi
  v=$(shorten "$v" "$vw")
  printf '  %s%-7s%s %s%s%s\n' "$C_RED" "$l" "$RST" "$BLD$C_RED" "$v" "$RST"
}

cpu_detail=''
if [[ -n $cpu_mhz ]]; then cpu_detail="@${cpu_mhz}GHz"; fi
gpu_detail=''
if [[ -z $gpu_pct ]]; then gpu_detail=$(t na); fi
temp_detail=$(t na)
if [[ $cpu_t =~ ^[0-9]+$ ]]; then temp_detail="${cpu_t}/${t_limit}°C"; fi
ram_detail="$(human "$mem_used_b")/$(human "$mem_total_b")"
swap_detail='sin swap'
if (( swap_total_b > 0 )); then swap_detail="$(human "$swap_used_b")/$(human "$swap_total_b")"; fi
disk_detail=$(t na)
if (( disk_ok )); then disk_detail="$(human "$disk_used")/$(human "$disk_size")"; fi
bat_detail=''
if [[ -n $bat_cap ]]; then
  bat_detail=$(bat_state "$bat_status")
  if [[ -n $bat_limit ]]; then bat_detail+=" · ${bat_limit}%"; fi
fi
home_detail=''
if (( home_sep )); then home_detail="$(human "$home_used")/$(human "$home_size")"; fi

render_metrics() {
  local s=$1
  trow2 'CPU' $(( cpu_pct * s / 100 )) "$cpu_detail" 'RAM' $(( mem_pct * s / 100 )) "$ram_detail"
  trow2 'Temp' $(( t_pct * s / 100 )) "$temp_detail" 'SWAP' $(( swap_pct * s / 100 )) "$swap_detail"
  trow2 "$(t load)" $(( load_pct * s / 100 )) "$l1" "$(t disk)" $(( disk_pct * s / 100 )) "$disk_detail"
  if [[ -n $bat_cap ]]; then
    trow2 'GPU' $(( ${gpu_pct:-0} * s / 100 )) "$gpu_detail" 'Bat' $(( bat_cap * s / 100 )) "$bat_detail"
  else
    trow2 'GPU' $(( ${gpu_pct:-0} * s / 100 )) "$gpu_detail" '' 0 ''
  fi
  local L ll pad R
  L=$(hist_str)
  ll=16
  if (( home_sep )); then
    pad=$(( LEFT_W + GAP - ll ))
    if (( pad < 2 )); then pad=2; fi
    R=$(trow 'Home' $(( home_pct * s / 100 )) "$home_detail" 0)
    printf '%s%*s%s\n' "$L" "$pad" '' "$R"
  else
    printf '%s\n' "$L"
  fi
}

pub=''
if (( net )); then
  pub=$(public_ip)
  pub=${pub:-$(t offline)}
else
  pub=$(t disabled_net)
fi

rule_w=$(( cols - 4 ))
if (( rule_w > 76 )); then rule_w=76; fi
printf '\n'
draw_rule "$rule_w"
printf '\n'

if (( wide )); then
  hdr2 "$(t system)" 'HARDWARE'
  sline2 "$(t uptime)" "$uptime_str" 'CPU' "$cpu_model"
  sline2 'Shell' "$shell_v" 'GPU' "${gpu:-$(t na)}"
  sline2 'Kernel' "$kernel" 'LAN' "$(lan_info)"
  sline2 "$(t cores)" "$cores" "$(t public)" "$pub"
  printf '\n'
  hdr2 "$(t performance)" "$(t memory)"
  if (( anim )); then
    render_metrics 0
    for s in 16 33 50 66 83 100; do
      printf '\033[5A'
      render_metrics "$s"
      sleep "$anim_bar_delay"
    done
  else
    render_metrics 100
  fi
else
  hdr1 "$(t system)"
  sline1 "$(t uptime)" "$uptime_str"
  sline1 'Shell' "$shell_v"
  sline1 'Kernel' "$kernel"
  sline1 "$(t cores)" "$cores"
  sline1 'CPU' "$cpu_model"
  sline1 'GPU' "${gpu:-$(t na)}"
  sline1 'LAN' "$(lan_info)"
  sline1 "$(t public)" "$pub"
  printf '\n'
  hdr1 "$(t performance)"
  trow 'CPU' "$cpu_pct" "$cpu_detail"
  trow 'Temp' "$t_pct" "$temp_detail"
  trow "$(t load)" "$load_pct" "$l1"
  trow 'GPU' "${gpu_pct:-0}" "$gpu_detail"
  trow 'RAM' "$mem_pct" "$ram_detail"
  trow 'SWAP' "$swap_pct" "$swap_detail"
  trow "$(t disk)" "$disk_pct" "$disk_detail"
  if (( home_sep )); then
    trow 'Home' "$home_pct" "$home_detail"
  fi
  if [[ -n $bat_cap ]]; then
    trow 'Bat' "$bat_cap" "$bat_detail"
  fi
  hist_str
fi
